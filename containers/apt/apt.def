# Singularity/Apptainer equivalent of the Dockerfile in this directory, for
# sites (such as NCI Gadi) that provide singularity but not docker.
#
# Read the licensing notice in the Dockerfile before building. In short: APT
# is proprietary, the EULA forbids redistribution, and the resulting .sif
# must not be shared beyond the machines you own or control.
#
# Build (needs --fakeroot, or root):
#
#   module load singularity
#   singularity build --fakeroot apt-2.12.0.sif containers/apt/apt.def
#
# To pin a different version, edit APT_VERSION and APT_SHA256 in %post below.
# Build arguments are deliberately not used: --build-arg and %arguments
# templating are unavailable in SingularityCE 3.11 (the version on Gadi), so
# editing the two variables is the portable option.
#
# Note that Thermo Fisher publishes only the current release. The manuscript
# run used 2.10.0, which is no longer available for download.

Bootstrap: docker
From: debian:bookworm-slim

%post
    set -eu

    APT_VERSION=2.12.0
    # sha256 of apt_2.12.0_linux_64_x86_binaries.zip (205,220,602 bytes),
    # verified against the published download. Change with APT_VERSION.
    APT_SHA256=d715adbc0a14df71e42f14bf250d3c39718d7a6712e8b8b2127192715196bafe
    APT_URL="https://downloads.thermofisher.com/APT/APT_${APT_VERSION}/apt_${APT_VERSION}_linux_64_x86_binaries.zip"

    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl unzip
    rm -rf /var/lib/apt/lists/*

    # Fail the build rather than bake in an unverified archive.
    curl -fsSL -o /tmp/apt.zip "$APT_URL"
    printf '%s  /tmp/apt.zip\n' "$APT_SHA256" | sha256sum -c -

    mkdir -p /opt/apt
    unzip -q /tmp/apt.zip -d /opt/apt
    rm /tmp/apt.zip
    chmod +x /opt/apt/bin/*

    # Record the real version in the build log. The tag on the image this
    # replaces did not match its contents.
    /opt/apt/bin/apt-genotype-axiom --version

    # Drop the build-time tooling again; the APT binaries are statically
    # linked and need nothing at runtime.
    apt-get purge -y curl unzip
    apt-get autoremove -y
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH="/opt/apt/bin:$PATH"

%test
    # Fails the build if the binaries did not land or will not execute.
    /opt/apt/bin/apt-genotype-axiom --version

%labels
    Version 2.12.0
    Vendor Thermo Fisher Scientific
    License LicenseRef-ThermoFisher-APT-EULA
    Notice Proprietary. Redistribution prohibited by the APT EULA; do not publish this image.
