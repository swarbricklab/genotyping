from pathlib import Path
import pandas as pd
import numpy as np

# Global paths
logs=Path(config['outs']['logs'])
vcf_hg19=Path(config['outs']['vcf_hg19'])
vcf_hg38=Path(config['outs']['vcf_hg38'])
psam=Path(config['outs']['psam'])
id_map=Path(config['outs']['id_map'])
out_dir=vcf_hg38.parent

# Container image providing APT and SNPolisher for the rules in apt.smk.
#
# APT is proprietary and cannot be redistributed with this workflow, so the
# image has to be supplied by whoever runs it. Build one with the Dockerfile
# in containers/apt/ and set containers.apt in the config file, either to a
# registry reference or to the path of a local .sif file.
#
# The default below names the image used for our published runs. It is a
# private registry repository, so it will not pull for anyone outside the lab
# -- that is deliberate rather than an oversight. It is kept as the default so
# that the config files of existing datasets keep resolving to the exact image
# their results were produced with, and so that the provenance is recorded in
# the code rather than only in prose.
apt_container=config.get('containers', {}).get(
    'apt', "docker://swarbricklab/ctp-tools:apt-2.10.2"
)

include: "rules/prep.smk"
include: "rules/qc.smk"
include: "rules/apt.smk"
include: "rules/bcftools.smk"
include: "rules/psam.smk"

# Rules that are too small to be worth a scheduler round-trip: each handles at
# most a few thousand rows, or a file of a few hundred KB. Running them in the
# Snakemake process avoids a queue wait per rule.
# Note that none of these declare a container, so they do not need singularity
# on the submit host. Every rule that does real work (prepare_hg19 onwards)
# declares one and stays on the cluster.
localrules:
    map_donors,
    list_cel_files,
    filter_dqc,
    filter_call_rate,
    plate_qc,
    prepare_int_fai,
    prepare_chromosome_maps,
    prepare_chain,
    make_psam,

rule all:
    input:
        vcf_hg19,
        vcf_hg38,
        psam,
        id_map


