<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Genotyping QC Report{% endblock %}</title>
  <link rel="stylesheet" href="assets/css/report.css">
</head>
<body>
  <header class="site">
    <h1>Genotyping QC Report</h1>
    <p class="subtitle">Axiom SNP microarray &rarr; VCF &middot; generated {{ generated }}</p>
    <nav class="site">
      <a href="index.html" class="{{ 'active' if active == 'index' else '' }}">Overview</a>
      <a href="qc.html" class="{{ 'active' if active == 'qc' else '' }}">Sample QC</a>
      <a href="variants.html" class="{{ 'active' if active == 'variants' else '' }}">Variants</a>
      <a href="relatedness.html" class="{{ 'active' if active == 'relatedness' else '' }}">Relatedness</a>
      <a href="methods.html" class="{{ 'active' if active == 'methods' else '' }}">Methods &amp; glossary</a>
    </nav>
  </header>
  <main>
    {% block content %}{% endblock %}
  </main>
  <footer class="site">
    Generated by the <strong>genotyping</strong> workflow on {{ generated }}.
  </footer>
  <script src="assets/js/table.js"></script>
</body>
</html>
